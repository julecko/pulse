[Unit]
Description=Pulse monitoring server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulse-server
Group=pulse-server
ExecStart=/usr/lib/pulse-server/pulse-serverd
Restart=on-failure
RestartSec=5
# Argon2 password checks run on blocking-pool threads; glibc gives each OS
# thread its own malloc arena, and freed argon2 buffers (~19 MiB each) can
# sit uncollected in a thread's arena instead of being reused or returned
# to the OS. Capping arenas keeps memory bounded as login traffic scales up.
Environment=MALLOC_ARENA_MAX=2
# One file descriptor per connection: room for [web.connections] max
# (default 4096) plus the database and logs. The default soft limit is 1024.
LimitNOFILE=8192

# /var/lib/pulse-server (SQLite database) and /var/log/pulse-server, owned by
# pulse-server. Config and TLS certs are read from /etc/pulse-server.
StateDirectory=pulse-server
StateDirectoryMode=0750
LogsDirectory=pulse-server
LogsDirectoryMode=0750
UMask=0027

# Hardening: the server only needs its own state/log dirs and the network.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
