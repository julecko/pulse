#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "purge" ]; then
    # Database, logs and the TLS cert generated by postinst. The pulse-server
    # system user is left in place, as Debian policy recommends.
    rm -rf /var/lib/pulse-server /var/log/pulse-server /etc/pulse-server/certs
    rmdir /etc/pulse-server 2>/dev/null || true
fi
