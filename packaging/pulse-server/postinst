#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # The key below is chowned to the pulse-server group, so the user must
    # exist first. The generated section at the end of this script creates
    # it too, but only after this block (and starts the service, which
    # needs the cert).
    systemd-sysusers pulse-server.conf

    # Generate a self-signed TLS cert on first install, so the server can
    # start right away. Replace both files to use a real cert; the key must
    # stay readable by the pulse-server group.
    CERT_DIR=/etc/pulse-server/certs
    if [ ! -e "$CERT_DIR/cert.pem" ] && [ ! -e "$CERT_DIR/key.pem" ]; then
        pulse-server-gen-cert
    elif [ -e "$CERT_DIR/cert.pem" ] && ! openssl x509 -in "$CERT_DIR/cert.pem" -noout -ext subjectAltName 2>/dev/null | grep -q .; then
        # Certs generated by older pulse-server versions have no subjectAltName (and
        # are marked CA:TRUE), which agents now reject since they verify
        # the server's cert.
        cat <<'MSG'

pulse-server: WARNING: /etc/pulse-server/certs/cert.pem has no subjectAltName,
so agents and pulse-server-cli will reject it. If it's the self-signed cert
generated on install, replace it with:

  sudo pulse-server-gen-cert --force [extra DNS names or IPs agents use]
  sudo systemctl restart pulse-serverd

then copy the new cert.pem to each agent (see the README, "TLS certs").

MSG
    fi
fi

#DEBHELPER#
