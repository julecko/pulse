#!/bin/sh
set -e

# The agent is installed disabled: it needs to know which server to report
# to before it's worth starting. Upgrades restart it only if it's enabled.
if [ "$1" = "configure" ] && [ -z "$2" ]; then
    cat <<'MSG'

pulse-agent is installed but not started. To finish setting it up:

  1. If the server uses its self-signed cert (the default), copy the
     server's /etc/pulse-server/certs/cert.pem to this host:
       sudo install -m 0644 cert.pem /etc/pulse-agent/server.pem
  2. Set server_addr to your Pulse server (host:port), and uncomment
     ca_cert if you did step 1:
       sudoedit /etc/pulse-agent/agent.toml
  3. Start the agent and enable it at boot:
       sudo systemctl enable --now pulse-agentd
  4. On the server (logs in as a Pulse user), open pairing if it's
     closed (it is by default), approve the agent, then close it again.
     Before approving, check that the fingerprint in `agents list` is the
     one this host prints with `sudo pulse-agent-cli fingerprint`:
       pulse-server-cli -u <user> agents pairing open --minutes 15
       pulse-server-cli -u <user> agents list
       pulse-server-cli -u <user> agents approve <id>
       pulse-server-cli -u <user> agents pairing close

MSG
fi

# The PAM hook moved out of pulse-agentd (first /usr/bin, later
# /usr/lib/pulse-agent) into pulse-agent-cli. PAM lines added for an older
# version still call `pulse-agentd pam-hook`, which the daemon now rejects;
# they fail silently (they're `optional`), so login events stop being
# reported. The package never edits PAM config itself, so just say which
# files need updating.
NEW="/usr/bin/pulse-agent-cli pam-hook"
if [ "$1" = "configure" ] && [ -n "$2" ]; then
    STALE=$(grep -lE 'pulse-agentd[[:space:]]+pam-hook' /etc/pam.d/* 2>/dev/null || true)
    if [ -n "$STALE" ]; then
        echo
        echo "pulse-agent: WARNING: the PAM hook is now \`$NEW\`, but these PAM"
        echo "files still call \`pulse-agentd pam-hook\`, so login events aren't reported:"
        echo "$STALE" | sed 's/^/  /'
        echo "Update them, e.g.:"
        echo "  sudo sed -i -E 's#[^[:space:]]*pulse-agentd[[:space:]]+pam-hook#$NEW#' $(echo $STALE)"
        echo
    fi
fi

