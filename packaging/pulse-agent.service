[Unit]
Description=pulse metrics agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/lib/pulse/pulse-agentd
Restart=on-failure
# Static user (not DynamicUser) so `pulse-agent cert generate` can chown the
# client TLS key to an account the daemon can read. Created by the deb postinst.
User=pulse
Group=pulse
# Config + TLS cert/key read from /etc/pulse/agent.toml
ConfigurationDirectory=pulse
# machine id is persisted here when /etc/machine-id is unavailable
StateDirectory=pulse
Environment=XDG_STATE_HOME=/var/lib
# Release default log target: /var/log/pulse/agent.log
LogsDirectory=pulse
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
